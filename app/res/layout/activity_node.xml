<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/headerBg"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/cd_back" />

        <HorizontalScrollView
            android:id="@+id/crumbScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/crumbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="@string/cd_more" />
    </LinearLayout>

    <TextView
        android:id="@+id/hintBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@drawable/bg_hint_bar"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/hint_placing"
        android:textColor="@color/hintBarText"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/photoBg">

        <com.nawle.app.InteractiveImageView
            android:id="@+id/ivImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/node_empty_title"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginLeft="32dp"
                android:layout_marginRight="32dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/node_empty_body"
                android:textColor="#99FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnFirstPhoto"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_btn_primary"
                android:drawableLeft="@drawable/ic_camera_white"
                android:drawablePadding="8dp"
                android:paddingLeft="22dp"
                android:paddingRight="26dp"
                android:text="@string/first_photo"
                android:textAllCaps="false"
                android:textColor="@color/onPrimary"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/stripScroll"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:scrollbars="none"
        android:background="@color/stripBg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <LinearLayout
            android:id="@+id/strip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:padding="12dp">

        <Button
            android:id="@+id/btnAddPhoto"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary"
            android:drawableLeft="@drawable/ic_camera_white"
            android:drawablePadding="6dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/add_photo"
            android:textAllCaps="false"
            android:textColor="@color/onPrimary"
            android:textSize="15sp" />

        <View
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnHotspot"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tonal"
            android:drawableLeft="@drawable/ic_adjust_teal"
            android:drawablePadding="6dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/add_hotspot"
            android:textAllCaps="false"
            android:textColor="@color/onPrimaryContainer"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
