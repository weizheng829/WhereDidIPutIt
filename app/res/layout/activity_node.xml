<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="?attr/headerBg"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:src="@drawable/ic_back"
            android:tint="?attr/onHeader"
            android:contentDescription="@string/cd_back" />

        <HorizontalScrollView
            android:id="@+id/crumbScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/crumbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:src="@drawable/ic_more_vert"
            android:tint="?attr/onHeader"
            android:contentDescription="@string/cd_more" />
    </LinearLayout>

    <TextView
        android:id="@+id/hintBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@drawable/bg_hint_bar"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/hint_placing"
        android:textColor="?attr/hintBarText"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/framePhoto"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/photoBg">

        <com.nawle.app.InteractiveImageView
            android:id="@+id/ivImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/node_empty_title"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmptyBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginLeft="32dp"
                android:layout_marginRight="32dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/node_empty_body"
                android:textColor="#99FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnFirstPhoto"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_btn_primary"
                android:drawableLeft="@drawable/ic_camera"
                android:drawablePadding="8dp"
                android:paddingLeft="22dp"
                android:paddingRight="26dp"
                android:text="@string/first_photo"
                android:textAllCaps="false"
                android:textColor="?attr/onPrimary"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <GridView
        android:id="@+id/gridAlbum"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="4"
        android:stretchMode="columnWidth"
        android:horizontalSpacing="4dp"
        android:verticalSpacing="4dp"
        android:padding="8dp"
        android:clipToPadding="false"
        android:background="?attr/surface"
        android:listSelector="?android:attr/selectableItemBackground"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/stripScroll"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:scrollbars="none"
        android:background="?attr/stripBg"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <LinearLayout
            android:id="@+id/strip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/surface"
        android:paddingLeft="12dp"
        android:paddingTop="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/btnHotspot"
            android:stateListAnimator="@null"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tonal"
            android:drawablePadding="6dp"
            android:drawableLeft="@drawable/ic_adjust_teal"
            android:gravity="center"
            android:singleLine="true"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_marginRight="10dp"
            android:text="@string/add_hotspot"
            android:textAllCaps="false"
            android:textColor="?attr/onPrimaryContainer"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnExpand"
            android:stateListAnimator="@null"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tonal"
            android:drawablePadding="6dp"
            android:drawableLeft="@drawable/ic_grid_teal"
            android:gravity="center"
            android:singleLine="true"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/add_expand"
            android:textAllCaps="false"
            android:textColor="?attr/onPrimaryContainer"
            android:textSize="15sp" />

        <!-- 相册查看大图时：对当前照片的可见操作入口 -->
        <Button
            android:id="@+id/btnRenamePic"
            android:stateListAnimator="@null"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tonal"
            android:drawablePadding="6dp"
            android:drawableLeft="@drawable/ic_edit_teal"
            android:gravity="center"
            android:singleLine="true"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/act_rename"
            android:textAllCaps="false"
            android:textColor="?attr/onPrimaryContainer"
            android:textSize="15sp"
            android:layout_marginRight="10dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnDeletePic"
            android:stateListAnimator="@null"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_danger"
            android:drawablePadding="6dp"
            android:drawableLeft="@drawable/ic_delete"
            android:gravity="center"
            android:singleLine="true"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/btn_delete"
            android:textAllCaps="false"
            android:textColor="?attr/onDanger"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
