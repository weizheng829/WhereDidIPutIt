<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 框架属性 → 主题属性映射（具体色值由各主题 style 提供） -->
    <style name="AppBase" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">?attr/primary</item>
        <item name="android:colorPrimaryDark">?attr/statusBarBg</item>
        <item name="android:colorAccent">?attr/dialogAccent</item>
        <item name="android:colorControlActivated">?attr/dialogAccent</item>
        <item name="android:colorControlHighlight">?attr/controlHighlight</item>
        <item name="android:statusBarColor">?attr/statusBarBg</item>
        <item name="android:navigationBarColor">?attr/navBarBg</item>
        <item name="android:windowBackground">?attr/surface</item>
        <item name="android:textColorPrimary">?attr/onSurface</item>
        <item name="android:textColorSecondary">?attr/onSurfaceVariant</item>
        <!-- 关闭系统强制深色，夜间外观完全由 values-night 控制 -->
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- ═══ 默认主题：芒果橙 ═══
         色值引用 @color 资源，昼夜由 colors.xml / values-night 自动切换；
         API 27+ 导航栏融入页面底色的适配也走 values-v27 的颜色覆盖 -->
    <style name="AppTheme" parent="AppBase">
        <item name="android:alertDialogTheme">@style/AppDialog</item>
        <!-- API 27+：导航栏为浅色时手势条/三键图标用深色；旧系统忽略此项 -->
        <item name="android:windowLightNavigationBar">true</item>
        <item name="primary">@color/primary</item>
        <item name="onPrimary">@color/onPrimary</item>
        <item name="primaryDeep">@color/primaryDeep</item>
        <item name="primaryContainer">@color/primaryContainer</item>
        <item name="onPrimaryContainer">@color/onPrimaryContainer</item>
        <item name="accent">@color/accent</item>
        <item name="accentDeep">@color/accentDeep</item>
        <item name="onAccent">@color/onAccent</item>
        <item name="onDanger">@color/onDanger</item>
        <item name="surface">@color/surface</item>
        <item name="cardBg">@color/cardBg</item>
        <item name="onSurface">@color/onSurface</item>
        <item name="onSurfaceVariant">@color/onSurfaceVariant</item>
        <item name="outlineVariant">@color/outlineVariant</item>
        <item name="divider">@color/divider</item>
        <item name="headerBg">@color/headerBg</item>
        <item name="onHeader">@color/onHeader</item>
        <item name="onHeaderDim">@color/onHeaderDim</item>
        <item name="onHeaderFaint">@color/onHeaderFaint</item>
        <item name="statusBarBg">@color/statusBarBg</item>
        <item name="navBarBg">@color/navBarBg</item>
        <item name="scrim">@color/scrim</item>
        <item name="photoBg">@color/photoBg</item>
        <item name="stripBg">@color/stripBg</item>
        <item name="hintBarBg">@color/hintBarBg</item>
        <item name="hintBarText">@color/hintBarText</item>
        <item name="chipBg">@color/chipBg</item>
        <item name="chipText">@color/chipText</item>
        <item name="tileLetter">@color/tileLetter</item>
        <item name="dialogAccent">@color/dialogAccent</item>
        <item name="controlHighlight">@color/controlHighlight</item>
        <item name="arrowDim">@color/arrowDim</item>
        <item name="crumbPillStroke">@color/crumbPillStroke</item>
        <item name="danger">@color/danger</item>
        <item name="selScrim">@color/selScrim</item>
        <item name="searchBarBg">@color/searchBarBg</item>
        <item name="searchBarStroke">@color/searchBarStroke</item>
        <item name="headerPillBg">@color/headerPillBg</item>
        <item name="headerPillRipple">@color/headerPillRipple</item>
    </style>

